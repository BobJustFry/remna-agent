# Site block for the existing Caddy on this VPS
# (/opt/bob4fun-geodat-editor/Caddyfile). Do not run a second Caddy on :80/:443.
# https://caddyserver.com/docs/automatic-https
ragent.bob4.fun {
	encode gzip
	header Strict-Transport-Security "max-age=31536000; includeSubDomains"
	reverse_proxy remna-agent-web:80 {
		header_down -Server
	}
}
