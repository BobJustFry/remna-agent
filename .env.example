# Admin login (web UI)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me

# Secrets (generate strong random values for production)
SESSION_SECRET=change-me-session-secret-min-32-chars
# 32-byte key as hex (64 hex chars) or any passphrase hashed by the app
# ВАЖНО: не меняйте после создания нод — иначе пароли/ключи в БД нельзя расшифровать
CREDENTIALS_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database
POSTGRES_USER=remna
POSTGRES_PASSWORD=remna
POSTGRES_DB=remna_agent
DATABASE_URL=postgresql+asyncpg://remna:remna@db:5432/remna_agent

# Ports (host)
WEB_PORT=8080
API_PORT=8000
